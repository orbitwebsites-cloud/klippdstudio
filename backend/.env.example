# Optional. Without MongoDB, the single-user MVP persists to DATA_DIR/klipped-db.json.
# MONGO_URL=mongodb://localhost:27017
# DB_NAME=klipped
# Optional. Without this, a stable key is created inside DATA_DIR.
# MASTER_ENCRYPTION_KEY=replace-with-a-fernet-key
# Server-managed provider credentials. Never expose these in the frontend.
# SEED_GROQ_KEY=replace-with-your-groq-key
# SEED_CEREBRAS_KEY=replace-with-your-cerebras-key
DATA_DIR=/app/data
SFX_DIR=/app/backend/assets/sfx
# Comma-separated, with no trailing slash. Production example:
# CORS_ORIGINS=https://klippdstudio.com,https://www.klippdstudio.com
CORS_ORIGINS=http://localhost:3000
PUBLIC_BACKEND_URL=http://localhost:8000
MAX_VIDEO_BYTES=2147483648
MAX_ASSET_BYTES=524288000
# Keep disk use controlled: large uploads become compact H.264 working files.
COMPRESS_UPLOADS=true
UPLOAD_COMPRESSION_MIN_BYTES=26214400
UPLOAD_COMPRESSION_MAX_WIDTH=1920
UPLOAD_COMPRESSION_CRF=26
# Billing must set this on the server; users cannot choose a plan from the client.
# basic: $19/mo and 7-day project retention
# pro: $49/mo and 30-day project retention
# elite: $149/mo and no automatic project deletion
# enterprise: starts at $120/seat/mo; requires ENTERPRISE_APPROVED=true
SUBSCRIPTION_PLAN=basic
# ENTERPRISE_APPROVED=false
RETENTION_SWEEP_HOURS=6
# Stripe Billing is backend-only. Create recurring monthly Stripe Prices and
# configure an HTTPS webhook at /api/billing/webhook before enabling checkout.
# STRIPE_SECRET_KEY=sk_test_replace_me
# STRIPE_WEBHOOK_SECRET=whsec_replace_me
# STRIPE_PRICE_BASIC=price_replace_me
# STRIPE_PRICE_PRO=price_replace_me
# STRIPE_PRICE_ELITE=price_replace_me
FRONTEND_URL=http://localhost:3000
# auto uses ClamAV when installed and always enforces the built-in signature floor.
# Set required in deployments that install clamdscan/clamscan and must fail if unavailable.
ASSET_MALWARE_SCANNER=auto
# Optional request gate for a private MVP backend. Prefer Cloudflare Access for the public site.
# APP_ACCESS_TOKEN=replace-with-a-long-random-token
# ---------- Authentication (Clerk) ----------
# Real per-user login. Set CLERK_ISSUER to your Clerk instance's Frontend API
# origin (Clerk Dashboard > API Keys > "Issuer" / Frontend API URL), e.g.
# https://clerk.your-domain.com or https://your-app-12.clerk.accounts.dev
# The backend verifies session JWTs against <issuer>/.well-known/jwks.json.
# When unset, the backend runs in anonymous per-browser isolation mode.
# CLERK_ISSUER=https://your-app.clerk.accounts.dev
# Optional overrides:
# CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json
# CLERK_AUTHORIZED_PARTIES=https://klippdstudio.com,https://www.klippdstudio.com
# How long browser media/download tokens stay valid (seconds; default 12h).
# MEDIA_TOKEN_TTL_SECONDS=43200
