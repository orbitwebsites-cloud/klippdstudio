# This value is baked into the static frontend at build time.
# Production example: https://api.klippdstudio.com
REACT_APP_BACKEND_URL=http://localhost:8000

# Real user accounts via Clerk (https://clerk.com). Set the publishable key
# from Clerk Dashboard > API Keys. When set, the app requires sign-in; when
# unset, it runs in anonymous per-browser mode. Must match the Clerk instance
# whose CLERK_ISSUER is configured on the backend.
# REACT_APP_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
